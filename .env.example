# InduCore Environment Variables Template
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://inducore_user:inducore_pass@localhost:5432/inducore_db?sslmode=disable
REDIS_URL=redis://localhost:6379

# Kafka Messaging Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=inducore-gateway

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key-min-32-chars-long
OAUTH_CLIENT_ID=inducore-client-id
OAUTH_CLIENT_SECRET=inducore-client-secret

# Google Gemini AI Integration (Server-Side Only)
GEMINI_API_KEY=your-gemini-api-key-here
